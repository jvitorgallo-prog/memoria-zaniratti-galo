---
import "../styles/site.css";
import { url } from "../lib/urls";
import Favicon from "../components/Favicon.astro";
const localeHome = url("/pt/");
---
<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content="Memória das famílias Zaniratti e Galo." />
    <Favicon />
    <link rel="canonical" href={localeHome} />
    <meta http-equiv="refresh" content={"0;url=" + localeHome} />
    <title>Memória das famílias Zaniratti e Galo</title>
  </head>
  <body>
    <main class="page-shell">
      <h1>Memória das famílias Zaniratti e Galo</h1>
      <p><a href={localeHome}>Acessar a versão em português</a></p>
    </main>
  </body>
</html>
