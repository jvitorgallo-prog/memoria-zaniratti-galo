---
import SiteLayout from "../../layouts/SiteLayout.astro";
import PageIntro from "../../components/PageIntro.astro";
import { publicData } from "../../lib/data";
import { url } from "../../lib/urls";
const ids = ["luigi", "pasqua", "custode", "valentim", "reni", "rejane", "jv"];
const people = ids.map(id => publicData.people.find(person => person.id === id)).filter(person => person !== undefined);
const familyBranch = publicData.branches.find(branch => branch.person_ids.includes("jv"));
const treeHref = (id: string, highlight = false) => familyBranch
  ? url(`/pt/arvores/${encodeURIComponent(familyBranch.id)}/?pessoa=${encodeURIComponent(id)}${highlight ? "&caminho=jv" : ""}#atlas`)
  : url("/pt/arvores/");
---
<SiteLayout title="De Luigi e Pasqua a João Vitor">
  <PageIntro eyebrow="Um caminho na família" title="De Luigi e Pasqua a João Vitor" lede="Uma linha de gerações dentro da história Zaniratti. Abra a árvore para encontrar também irmãos, casamentos e os outros ramos." />
  <p><a class="button button-primary" href={treeHref("jv", true)}>Destacar este caminho na árvore</a></p>
  <section class="section"><ol class="lineage-people">
    {people.map(person => <li><a href={url(`/pt/pessoas/${person.id}/`)}>{person.label}</a><a class="view-relative" href={treeHref(person.id)}>Ver família →</a></li>)}
  </ol></section>
  <p class="prose">Luigi Zaniratti e Pasqua Mellara são os pais de Custode Sante. O caminho segue por Valentim, Reni e Rejane até João Vitor Galo Esteves. Os filhos e descendentes de cada geração continuam acessíveis nas respectivas páginas e na árvore.</p>
</SiteLayout>
<style>
  .lineage-people{list-style:none;padding:0;max-width:48rem;border-left:1px solid var(--atlas-line,#cbd0d0);margin-left:.5rem}
  .lineage-people li{position:relative;padding:1.1rem 1.5rem;display:flex;justify-content:space-between;gap:1rem;font-family:var(--atlas-serif,Georgia,serif);font-size:1.5rem}
  .lineage-people li::before{content:"";position:absolute;left:-5px;top:1.8rem;width:9px;height:9px;border-radius:50%;background:var(--atlas-blue,#345ad8)}
  .view-relative{font-family:var(--atlas-sans,system-ui,sans-serif);font-size:.9rem;align-self:center;white-space:nowrap}
  @media(max-width:520px){.lineage-people li{flex-direction:column;font-size:1.25rem}.view-relative{align-self:flex-start}}
</style>
