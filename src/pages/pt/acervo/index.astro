---
import SiteLayout from "../../../layouts/SiteLayout.astro";
import { publicData as snapshot } from "../../../lib/data";
import type { PublicArchiveItem } from "../../../lib/data";
import { url } from "../../../lib/urls";
const items: PublicArchiveItem[] = snapshot.archive_items || [];
const people = snapshot.people || [];
const personById = new Map(people.map((person) => [person.id, person]));
const kinds = [...new Set(items.map((item) => item.kind).filter(Boolean))].sort((a,b) => a.localeCompare(b,"pt-BR"));
const kindLabel = (kind: string) => ({ historical_page: "Página do site", photograph: "Imagem", image: "Imagem", document: "Documento", diagram: "Diagrama", inventory_record: "Registro de catálogo" } as Record<string,string>)[kind] || "Item do acervo";
const sortedPeople = [...people].sort((a,b) => a.label.localeCompare(b.label,"pt-BR"));
const available = (item: PublicArchiveItem) => Boolean(item.public_path || item.transcript);
const statusText = (status: string) => ({ public_derivative: "Versão de leitura", original_public: "Cópia pública", capture_indexed: "Captura indexada", catalog_only: "Referência catalogada", local_copy_review_needed: "Cópia local em revisão" } as Record<string,string>)[status] || status;
const thumb = (item: PublicArchiveItem) => item.public_path && /\.(?:png|jpe?g|webp|gif|avif)$/i.test(item.public_path);
---
<SiteLayout active="acervo" title="Acervo da família" description="Documentos, fotografias e páginas recuperadas ligados à história da Família Zaniratti.">
  <div class="archive-page">
    <nav class="archive-breadcrumb" aria-label="Caminho de navegação"><a href={url("/pt/")}>Árvore</a><span>/</span><span aria-current="page">Acervo</span></nav>
    <header class="archive-intro"><p class="archive-kicker">Documentos, imagens e páginas de família</p><h1>Acervo</h1><p>Um lugar para ler o material recuperado e encontrar os registros ligados às pessoas e aos lugares da família.</p>
      <div class="archive-summary"><strong>{items.length}</strong><span>itens catalogados</span><strong>{items.filter(available).length}</strong><span>com cópia ou transcrição pública</span></div>
    </header>
    <section class="archive-controls" aria-label="Busca no acervo">
      <label>Buscar no acervo<input type="search" id="archive-search" placeholder="Nome, título ou palavra do texto" /></label>
      <label>Tipo<select id="archive-kind"><option value="">Todos os tipos</option>{kinds.map((kind) => <option value={kind}>{kindLabel(kind)}</option>)}</select></label>
      <label>Pessoa<select id="archive-person"><option value="">Todas as pessoas</option>{sortedPeople.map((person) => <option value={person.id}>{person.label}</option>)}</select></label>
      <p id="archive-result-count" aria-live="polite">{items.length} itens</p>
    </section>
    <nav class="archive-pagination" id="archive-pagination" aria-label="Páginas do acervo" hidden>
      <button type="button" id="archive-prev" aria-label="Página anterior">← Anterior</button>
      <span id="archive-page-count" aria-live="polite"></span>
      <button type="button" id="archive-next" aria-label="Próxima página">Próxima →</button>
    </nav>
    {items.length ? <div class="archive-grid" id="archive-grid">
      {items.map((item) => {
        const related = (item.person_ids || []).map((id) => personById.get(id)).filter((person): person is (typeof people)[number] => Boolean(person));
        const image = thumb(item);
        const text = [item.title, item.description, item.transcript, ...related.map((person) => person.label)].filter(Boolean).join(" ").toLocaleLowerCase("pt-BR");
        return <article class="archive-card" data-kind={item.kind} data-person-ids={(item.person_ids || []).join("|")} data-search={text}>
          <a class="archive-card-link" data-archive-link href={url("/pt/acervo/" + encodeURIComponent(item.id) + "/")}>
            <div class:list={["archive-card-visual", image && "has-image"]}>
              {image ? <img src={url("/" + item.public_path!.replace(/^\//,""))} alt="" loading="lazy" /> : <span class="archive-visual-mark" aria-hidden="true">{item.kind === "historical_page" ? "WWW" : item.kind === "document" ? "DOC" : "IMG"}</span>}
              <span class="archive-status">{statusText(item.status)}</span>
            </div>
            <div class="archive-card-copy"><p class="archive-kind">{kindLabel(item.kind)}</p><h2>{item.title}</h2>{item.description && <p>{item.description}</p>}
              {related.length > 0 && <p class="archive-related">{related.slice(0,4).map((person) => person.label).join(" · ")}{related.length > 4 ? ` +${related.length - 4}` : ""}</p>}
              {item.capture_timestamp_utc && <small>Capturado em {item.capture_timestamp_utc}</small>}
            </div>
          </a>
        </article>;
      })}
    </div> : <p class="archive-empty">O catálogo público está sendo preparado a partir dos materiais preservados.</p>}
    <p class="archive-filter-empty" id="archive-filter-empty" hidden>Nenhum item corresponde a esta busca.</p>
    <noscript><p class="archive-noscript">A busca e a paginação interativas precisam de JavaScript. Todos os itens continuam disponíveis nos cartões acima.</p></noscript>
  </div>
</SiteLayout>
<script>
  const input = document.querySelector<HTMLInputElement>("#archive-search");
  const kind = document.querySelector<HTMLSelectElement>("#archive-kind");
  const person = document.querySelector<HTMLSelectElement>("#archive-person");
  const cards = [...document.querySelectorAll<HTMLElement>("#archive-grid .archive-card")];
  const count = document.querySelector<HTMLElement>("#archive-result-count");
  const pagination = document.querySelector<HTMLElement>("#archive-pagination");
  const pageCount = document.querySelector<HTMLElement>("#archive-page-count");
  const previous = document.querySelector<HTMLButtonElement>("#archive-prev");
  const next = document.querySelector<HTMLButtonElement>("#archive-next");
  const empty = document.querySelector<HTMLElement>("#archive-filter-empty");
  const pageSize = 36;
  const normalize = (value: string) => value.normalize("NFD").replace(/[\u0300-\u036f]/g, "").toLocaleLowerCase("pt-BR").trim();
  const params = new URLSearchParams(window.location.search);
  if (input) input.value = params.get("q") || "";
  if (kind) kind.value = params.get("tipo") || "";
  if (person) person.value = params.get("pessoa") || "";
  let page = Math.max(1, Number(params.get("pagina") || 1) || 1);
  if (pagination) pagination.hidden = false;
  const update = () => {
    const query = normalize(input?.value || "");
    const selected = kind?.value || "";
    const selectedPerson = person?.value || "";
    const matches: HTMLElement[] = [];
    for (const card of cards) {
      const personIds = (card.dataset.personIds || "").split("|");
      const match = (!query || normalize(card.dataset.search || "").includes(query)) && (!selected || card.dataset.kind === selected) && (!selectedPerson || personIds.includes(selectedPerson));
      if (match) matches.push(card);
    }
    const pageTotal = Math.max(1, Math.ceil(matches.length / pageSize));
    page = Math.min(page, pageTotal);
    const start = (page - 1) * pageSize;
    const visibleCards = new Set(matches.slice(start, start + pageSize));
    for (const card of cards) card.hidden = !visibleCards.has(card);
    if (count) count.textContent = `${matches.length} ${matches.length === 1 ? "item" : "itens"} · página ${page} de ${pageTotal}`;
    if (pageCount) pageCount.textContent = `Página ${page} de ${pageTotal}`;
    if (previous) previous.disabled = page <= 1;
    if (next) next.disabled = page >= pageTotal;
    if (empty) empty.hidden = matches.length > 0;
    const nextParams = new URLSearchParams(window.location.search);
    query ? nextParams.set("q", input?.value.trim() || "") : nextParams.delete("q");
    selected ? nextParams.set("tipo", selected) : nextParams.delete("tipo");
    selectedPerson ? nextParams.set("pessoa", selectedPerson) : nextParams.delete("pessoa");
    page > 1 ? nextParams.set("pagina", String(page)) : nextParams.delete("pagina");
    const queryString = nextParams.toString();
    history.replaceState(history.state, "", `${window.location.pathname}${queryString ? `?${queryString}` : ""}${window.location.hash}`);
  };
  const resetAndUpdate = () => { page = 1; update(); };
  input?.addEventListener("input", resetAndUpdate);
  kind?.addEventListener("change", resetAndUpdate);
  person?.addEventListener("change", resetAndUpdate);
  previous?.addEventListener("click", () => { page = Math.max(1, page - 1); update(); document.querySelector("#archive-grid")?.scrollIntoView({ behavior: "smooth", block: "start" }); });
  next?.addEventListener("click", () => { page++; update(); document.querySelector("#archive-grid")?.scrollIntoView({ behavior: "smooth", block: "start" }); });
  for (const link of document.querySelectorAll<HTMLAnchorElement>("[data-archive-link]")) link.addEventListener("click", () => {
    const returnQuery = window.location.search;
    if (!returnQuery) return;
    const target = new URL(link.href);
    target.searchParams.set("volta", returnQuery);
    link.href = target.toString();
  });
  update();
</script>
<style>
  .archive-page { --ar-ink:#172b3a;--ar-blue:#326bb0;--ar-pale:#edf3f8;--ar-line:#d8e0e6;--ar-muted:#5b6873;--ar-paper:#fffefa;color:var(--ar-ink); }
  .archive-breadcrumb { display:flex;gap:9px;margin-bottom:24px;color:var(--ar-muted);font-size:.85rem; }
  .archive-breadcrumb a { color:inherit; }
  .archive-intro { max-width:820px;padding:clamp(28px,6vw,64px);border-radius:16px;background:#18364b;color:#f8fbfd; }
  .archive-kicker { margin:0 0 10px;color:#9bc4ee;font-size:.76rem;font-weight:750;letter-spacing:.12em;text-transform:uppercase; }
  .archive-intro h1 { color:white;font-size:clamp(2.5rem,6vw,4.4rem); }
  .archive-intro>p:not(.archive-kicker) { max-width:620px;color:#d7e2e9;font-size:1.08rem; }
  .archive-summary { display:flex;flex-wrap:wrap;align-items:baseline;gap:6px 10px;margin-top:25px;color:#d7e2e9;font-size:.85rem; }
  .archive-summary strong { margin-left:16px;color:white;font:2rem Georgia,serif; }
  .archive-summary strong:first-child { margin-left:0; }
  .archive-controls { display:grid;grid-template-columns:minmax(220px,1.2fr) minmax(150px,.6fr) minmax(210px,.9fr) auto;gap:16px;align-items:end;margin:32px 0 14px; }
  .archive-controls label { display:grid;gap:6px;font-size:.85rem;font-weight:700; }
  .archive-controls input,.archive-controls select { min-height:46px;padding:9px 12px;border:1px solid #bfcbd5;border-radius:7px;background:var(--ar-paper);font:inherit; }
  .archive-controls p { margin:0 0 10px;color:var(--ar-muted);font-size:.84rem;white-space:nowrap; }
  .archive-pagination { display:flex;justify-content:center;align-items:center;gap:15px;margin:18px 0 22px;color:var(--ar-muted);font-size:.9rem; }
  .archive-pagination[hidden] { display:none; }
  .archive-pagination button { min-height:40px;padding:8px 13px;border:1px solid var(--ar-line);border-radius:7px;background:var(--ar-paper);color:var(--ar-ink);font:inherit;cursor:pointer; }
  .archive-pagination button:disabled { opacity:.45;cursor:not-allowed; }
  .archive-grid { display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:16px; }
  .archive-card { min-width:0;overflow:hidden;border:1px solid var(--ar-line);border-radius:11px;background:var(--ar-paper); }
  .archive-card[hidden] { display:none; }
  .archive-card-link { display:flex;height:100%;flex-direction:column;color:inherit;text-decoration:none; }
  .archive-card-link:hover h2 { color:var(--ar-blue); }
  .archive-card-visual { position:relative;display:grid;place-items:center;height:185px;background:linear-gradient(135deg,#e8eef3,#f8f5eb); }
  .archive-card-visual.has-image img { width:100%;height:100%;object-fit:cover; }
  .archive-visual-mark { color:#7791a6;font-family:Georgia,serif;font-size:2rem;letter-spacing:.12em; }
  .archive-status { position:absolute;right:10px;bottom:10px;padding:5px 9px;border-radius:99px;background:rgba(255,254,250,.94);color:var(--ar-ink);font-size:.72rem; }
  .archive-card-copy { display:flex;flex:1;flex-direction:column;padding:17px 18px 19px; }
  .archive-kind { margin:0 0 6px;color:var(--ar-blue);font-size:.7rem;font-weight:750;letter-spacing:.1em;text-transform:uppercase; }
  .archive-card h2 { margin:0 0 9px;font-size:1.24rem; }
  .archive-card-copy>p:not(.archive-kind) { margin:0 0 10px;color:var(--ar-muted);font-size:.87rem; }
  .archive-card-copy .archive-related { margin-top:auto!important;color:var(--ar-ink)!important;font-size:.78rem!important; }
  .archive-card-copy small { color:var(--ar-muted);font-size:.74rem; }
  .archive-empty,.archive-noscript,.archive-filter-empty { color:var(--ar-muted); }
  @media(max-width:1100px){.archive-controls{grid-template-columns:repeat(2,minmax(0,1fr));}.archive-controls p{margin:0;align-self:end}}
  @media(max-width:920px){.archive-grid{grid-template-columns:repeat(2,minmax(0,1fr));}}
  @media(max-width:620px){.archive-grid{grid-template-columns:1fr;}.archive-controls{grid-template-columns:1fr;gap:10px}.archive-controls p{margin:0}.archive-card-visual{height:200px}.archive-pagination{gap:8px}.archive-pagination button{padding-inline:9px}}
</style>
