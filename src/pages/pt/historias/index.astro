---
import SiteLayout from "../../../layouts/SiteLayout.astro";
import { publicData as snapshot } from "../../../lib/data";
import { url } from "../../../lib/urls";
type Paragraph = { text: string; source_ids?: string[]; citation_ids?: string[] };
type Biography = { id: string; person_id: string; title?: string; paragraphs: Paragraph[]; source_ids?: string[] };
const data = snapshot as typeof snapshot & { biographies?: Biography[] };
const biographies = [...(data.biographies || [])].sort((a,b) => {
  const pa = snapshot.people.find((person) => person.id === a.person_id)?.label || "";
  const pb = snapshot.people.find((person) => person.id === b.person_id)?.label || "";
  return pa.localeCompare(pb,"pt-BR") || a.id.localeCompare(b.id);
});
const personById = new Map(snapshot.people.map((person) => [person.id, person]));
const visible = biographies.filter((bio) => bio.paragraphs?.some((paragraph) => paragraph.text.trim()));
const excerpt = (bio: Biography) => bio.paragraphs?.map((paragraph) => paragraph.text).join(" ").replace(/\s+/g," ").trim() || "";
---
<SiteLayout active="historias" title="Histórias da família" description="Biografias e relatos familiares ligados à Família Zaniratti.">
  <div class="stories-page">
    <nav class="stories-breadcrumb" aria-label="Caminho de navegação"><a href={url("/pt/arvores/")}>Árvores</a><span>/</span><span aria-current="page">Histórias</span></nav>
    <header class="stories-intro"><p class="stories-kicker">Memórias de pessoas e gerações</p><h1>Histórias</h1><p>Relatos e biografias ligados às pessoas da família. As referências aparecem junto aos textos e nas fichas pessoais.</p></header>
    <a class="branches-feature" href={url("/pt/historias/ramos-italianos/")}><span><small>Leitura de abertura</small><strong>Ramos italianos e brasileiros</strong><span>Mapas antigos, lugares de origem e histórias mantidas separadas quando os vínculos ainda não estão estabelecidos.</span></span><b aria-hidden="true">→</b></a>
    <a class="branches-feature" href={url("/pt/historias/jose-augusto/")}><span><small>Biografia atribuída a Edmondo Zaniratti</small><strong>José Augusto Zaniratti (1959)</strong><span>Leitura editorial da seção publicada em Zaniratti Continentes, separada da continuação autobiográfica do blog.</span></span><b aria-hidden="true">→</b></a>
    {visible.length ? <div class="stories-grid">{visible.map((bio) => {
      const person = personById.get(bio.person_id);
      if (!person) return null;
      return <article class="story-card"><p class="stories-kicker">{person.label}</p><h2><a href={url("/pt/historias/" + encodeURIComponent(bio.id) + "/")}>{bio.title || `A história de ${person.label}`}</a></h2><p>{excerpt(bio).slice(0,380)}{excerpt(bio).length > 380 ? "…" : ""}</p><div class="story-card-links"><a href={url("/pt/historias/" + encodeURIComponent(bio.id) + "/")}>Ler história →</a><a href={url("/pt/pessoas/" + encodeURIComponent(person.id) + "/")}>Ficha de {person.label.split(" ")[0]}</a></div></article>;
    })}</div> : <div class="stories-empty"><span aria-hidden="true">✳</span><div><h2>Histórias em organização</h2><p>As biografias recuperadas e os relatos familiares serão apresentados aqui quando estiverem disponíveis na edição pública.</p></div></div>}
  </div>
</SiteLayout>
<style>
  .stories-page{--st-ink:var(--atlas-ink,#142c43);--st-blue:var(--atlas-blue,#315dd8);--st-line:var(--atlas-line,#d7d1c7);--st-muted:var(--atlas-muted,#667487);--st-paper:var(--atlas-surface,#fffdf8);color:var(--st-ink)}.stories-breadcrumb{display:flex;gap:9px;margin-bottom:24px;color:var(--st-muted);font-size:.85rem}.stories-breadcrumb a{color:inherit}
  .stories-intro{max-width:850px;padding:24px 0 18px;border-bottom:1px solid var(--st-line);color:var(--st-ink)}.stories-kicker{margin:0 0 9px;color:var(--atlas-terra,#aa5f44);font-size:.72rem;font-weight:750;letter-spacing:.11em;text-transform:uppercase}.stories-intro h1{margin:.1em 0 .2em;color:var(--st-ink);font:500 clamp(2.5rem,6vw,4.4rem)/1.08 var(--atlas-serif,Georgia,serif)}.stories-intro>p:last-child{max-width:650px;color:var(--st-muted);font:1.08rem/1.7 var(--atlas-serif,Georgia,serif)}
  .branches-feature{display:flex;justify-content:space-between;gap:20px;align-items:center;max-width:850px;margin-top:18px;padding:18px 0;border-bottom:1px solid var(--st-line);color:var(--st-ink);text-decoration:none}.branches-feature>span{display:grid;gap:5px}.branches-feature small{color:var(--atlas-terra,#aa5f44);font-size:.68rem;font-weight:750;letter-spacing:.1em;text-transform:uppercase}.branches-feature strong{font:1.25rem var(--atlas-serif,Georgia,serif)}.branches-feature span span{color:var(--st-muted);font-size:.9rem;line-height:1.6}.branches-feature>b{color:var(--st-blue);font-size:1.3rem}.stories-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:15px;margin-top:30px}.story-card{display:flex;flex-direction:column;padding:20px;border:1px solid var(--st-line);border-radius:4px;background:var(--st-paper)}.story-card h2{margin:0 0 11px;font:500 1.45rem var(--atlas-serif,Georgia,serif)}.story-card h2 a{color:var(--st-ink);text-decoration:none}.story-card h2 a:hover{color:var(--st-blue)}.story-card>p:not(.stories-kicker){color:var(--st-muted);line-height:1.7}.story-card-links{display:flex;flex-wrap:wrap;gap:12px 20px;margin-top:auto;padding-top:13px;border-top:1px solid var(--st-line);font-size:.87rem;font-weight:650}.stories-empty{display:flex;gap:16px;max-width:720px;margin-top:30px;padding:20px 0;border-bottom:1px solid var(--st-line);background:transparent}.stories-empty>span{color:var(--st-blue);font-size:1.6rem}.stories-empty h2{margin:0 0 7px;font-size:1.25rem}.stories-empty p{margin:0;color:var(--st-muted)}
  @media(max-width:680px){.stories-grid{grid-template-columns:1fr}}
</style>
