---
import SiteLayout from "../../../layouts/SiteLayout.astro";
import { publicData as snapshot } from "../../../lib/data";
import { url } from "../../../lib/urls";
const archive = snapshot.archive_items || [];
const byPath = (path: string) => archive.find((item) => item.legacy_path === path);
const branches = [
  { path: "ITA/ForestaI.htm", title: "Um índice antigo, três árvores separadas", copy: "No índice de outubro de 2004, o site contabilizou árvores distintas para Francesco, em San Biagio de Bondeno; para os Zaniratti de Porto Alegre; e para Giovanni Battista, em Copparo. A própria página dizia que as origens ainda precisavam ser aprofundadas antes de reunir algumas árvores. Os números ali publicados são o recorte editorial daquele ano, não uma contagem atual nem uma prova de parentesco entre todos os grupos." },
  { path: "BRA/AlberoBondenoB.htm", title: "Bondeno e os descendentes no Brasil", copy: "Uma árvore posterior intitulada Francesco Zaniratti descreve seu ramo como originário de Bondeno e menciona descendentes em Minas Gerais, Espírito Santo e Rio de Janeiro. O mapa preservado apresenta ligações e lacunas entre as páginas. Cada vínculo deve ser lido na fonte individual correspondente; o título não autoriza atribuir automaticamente todos os Zaniratti brasileiros a esse ramo." },
  { path: "BRA/AlbGiobatB.htm", title: "Giovanni Battista e Copparo", copy: "O mapa de Giovanni Battista nomeia um ramo de Toscana e Lazio e diz que as pessoas das fotografias exibidas viviam na Itália. A mesma página registra que os rostos não podiam ser associados aos nomes. A árvore de Giovanni Battista permanece separada das linhas de Bondeno e Porto Alegre enquanto fontes não estabeleçam os elos." },
  { path: "BRA/AlbEnnioB.htm", title: "Ennio e outras pessoas na Itália", copy: "O título do mapa de Ennio Zaniratti e seu texto dizem que as pessoas ali representadas viviam na Itália; entre os alvos dos links aparece Primo, em Copparo. A ligação entre itens depende das páginas próprias e dos vínculos que elas registram, sem fusões feitas apenas por sobrenome." },
  { path: "BRA/AlbAlegreB.htm", title: "Porto Alegre: um mapa brasileiro separado", copy: "O mapa dos Zaniratti de Porto Alegre aponta para páginas de Luigi Camozzi e Francesco (1829), entre outras. O mapa de Bondeno lista separadamente Luigi (1803). A página de Luigi Camozzi não foi recuperada, então não atribuímos a ele a identidade ou a genealogia de Luigi 1803." },
  { path: "ITA/AlbSBiagioI.htm", title: "Salvatonica e San Biagio: uma hipótese em aberto", copy: "No mapa de uma família Zaniratti/Zanirati/Zannirati que viveu entre Salvatonica e San Biagio nos séculos XVIII e XIX, o autor do site escreveu que julgava provável o parentesco com a família de Francesco, mas que novas pesquisas seriam necessárias. Preservamos a frase como hipótese histórica do autor. Ela não foi convertida em vínculo confirmado." },
];
---
<SiteLayout active="historias" title="Ramos italianos e brasileiros" description="Árvores históricas de diferentes ramos Zaniratti na Itália e no Brasil, preservadas sem fusões sem prova.">
  <article class="branches-story">
    <nav class="branches-breadcrumb" aria-label="Caminho de navegação"><a href={url("/pt/arvores/")}>Árvores</a><span>/</span><a href={url("/pt/historias/")}>Histórias</a><span>/</span><span aria-current="page">Ramos italianos</span></nav>
    <header class="branches-intro"><p class="branches-kicker">Árvores, lugares e migrações</p><h1>Ramos italianos e brasileiros</h1><p>O site familiar antigo preservou mapas de famílias em diferentes localidades. A leitura conjunta mostra uma história ampla, com pessoas que permaneceram na Itália e outras que emigraram, mas também registra lacunas e hipóteses ainda abertas.</p></header>
    <section class="branches-reading"><h2>Árvores que o próprio site manteve distintas</h2><p>Em 2004, seu índice editorial listava separadamente a árvore de Francesco em San Biagio di Bondeno, os Zaniratti de Porto Alegre e a árvore de Giovanni Battista em Copparo. Em outros anos, o acervo apresenta mapas ligados a Bondeno, Ennio e a pessoas que viviam na Itália. Esses recortes ajudam a localizar histórias; não bastam para concluir que os ramos são todos um só.</p><p>Por isso, cada ficha pessoal mantém apenas vínculos sustentados por páginas ou documentos relacionados. A hipótese escrita pelo autor sobre Salvatonica/San Biagio e Francesco aparece como hipótese, enquanto a falta de uma página ou captura é mostrada como lacuna do acervo.</p></section>
    <div class="branch-cards">{branches.map((entry) => { const item = byPath(entry.path); return <section class="branch-card"><div><p class="branches-kicker">Fonte do acervo histórico</p><h2>{entry.title}</h2><p>{entry.copy}</p></div>{item ? <a href={url("/pt/acervo/" + encodeURIComponent(item.id) + "/")}>Ler a página preservada <span aria-hidden="true">↗</span></a> : <p class="branch-missing">Página citada no inventário; cópia legível ainda indisponível.</p>}</section>; })}</div>
    <footer class="branches-footer"><p>As árvores antigas usam suas próprias grafias e datas. Esta edição mantém variantes e vínculos citados em cada ficha, sem corrigir nomes por semelhança ou preencher elos ausentes.</p><a href={url("/pt/pessoas/")}>Explorar fichas pessoais →</a><a href={url("/pt/lugares/")}>Conhecer os lugares →</a></footer>
  </article>
</SiteLayout>
<style>
  .branches-story{--br-ink:var(--atlas-ink,#142c43);--br-blue:var(--atlas-blue,#315dd8);--br-line:var(--atlas-line,#d7d1c7);--br-muted:var(--atlas-muted,#667487);color:var(--br-ink)}.branches-breadcrumb{display:flex;flex-wrap:wrap;gap:9px;margin-bottom:24px;color:var(--br-muted);font-size:.85rem}.branches-breadcrumb a{color:inherit}.branches-intro{max-width:920px;padding:24px 0 20px;border-bottom:1px solid var(--br-line);color:var(--br-ink)}.branches-kicker{margin:0 0 8px;color:var(--atlas-terra,#aa5f44);font-size:.72rem;font-weight:750;letter-spacing:.11em;text-transform:uppercase}.branches-intro h1{max-width:800px;margin:.12em 0 .2em;color:var(--br-ink);font:500 clamp(2.35rem,6vw,4.1rem)/1.08 var(--atlas-serif,Georgia,serif)}.branches-intro>p:last-child{max-width:700px;color:var(--br-muted);font:1.08rem/1.7 var(--atlas-serif,Georgia,serif)}.branches-reading{max-width:780px;margin:30px 0 25px}.branches-reading h2{font:500 1.6rem var(--atlas-serif,Georgia,serif)}.branches-reading p{color:var(--br-muted);line-height:1.8}.branch-cards{display:grid;gap:10px}.branch-card{display:flex;justify-content:space-between;align-items:center;gap:24px;padding:20px 0;border-bottom:1px solid var(--br-line);background:transparent}.branch-card h2{margin:4px 0 9px;font:500 1.35rem var(--atlas-serif,Georgia,serif)}.branch-card div>p:last-child{max-width:72ch;margin-bottom:0;color:var(--br-muted);line-height:1.7}.branch-card>a{flex:0 0 auto;font-size:.87rem;font-weight:650}.branch-missing{max-width:210px;color:var(--br-muted);font-size:.82rem}.branches-footer{display:flex;flex-wrap:wrap;gap:13px 20px;align-items:baseline;margin-top:30px;padding:20px 0;border-top:1px solid var(--br-line)}.branches-footer p{flex-basis:100%;max-width:80ch;color:var(--br-muted);line-height:1.7}.branches-footer a{font-size:.88rem;font-weight:650}@media(max-width:650px){.branch-card{align-items:flex-start;flex-direction:column;gap:10px}}
</style>
