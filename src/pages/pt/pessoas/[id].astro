---
import SiteLayout from "../../../layouts/SiteLayout.astro";
import { publicData as snapshot } from "../../../lib/data";
import type { PublicAssertion, PublicPerson, PublicBiography, PublicArchiveItem } from "../../../lib/data";
import { url } from "../../../lib/urls";

type Relation = { other: PublicPerson; claims: PublicAssertion[] };
const people = snapshot.people || [];
const claims = snapshot.assertions || [];
const citations = snapshot.citations || [];
const sources = snapshot.sources || [];
const branches = snapshot.branches || [];
const groups = snapshot.groups || [];
const biographies: PublicBiography[] = snapshot.biographies || [];
const archiveItems: PublicArchiveItem[] = snapshot.archive_items || [];

export function getStaticPaths() {
  return (snapshot.people || []).map((person) => ({ params: { id: person.id }, props: { personId: person.id } }));
}

const person = people.find((item) => item.id === Astro.props.personId);
if (!person) throw new Error("Ficha de pessoa sem registro correspondente na projeção pública.");
const personId = person.id;
const personClaims = claims.filter((claim) => claim.subject_id === personId || claim.object_person_id === personId);
const claimById = new Map(claims.map((claim) => [claim.id, claim]));
const sourceById = new Map(sources.map((source) => [source.id, source]));
const citationById = new Map(citations.map((citation) => [citation.id, citation]));
const personById = new Map(people.map((item) => [item.id, item]));
const sourceHref = (id: string) => url("/pt/fontes/" + encodeURIComponent(id) + "/");
const personHref = (id: string) => url("/pt/pessoas/" + encodeURIComponent(id) + "/");
const primaryBranch = person.branch_ids?.[0];
const returnTree = primaryBranch
  ? url("/pt/arvores/" + encodeURIComponent(primaryBranch) + "/") + "?pessoa=" + encodeURIComponent(personId) + "#atlas"
  : url("/pt/arvores/");
const initials = person.label.trim().split(/\s+/).slice(0, 2).map((part) => part[0]).join("").toLocaleUpperCase("pt-BR");
const branchNames = (person.branch_ids || []).map((id) => branches.find((branch) => branch.id === id)?.label).filter((value): value is string => Boolean(value));

const relationEndpoint = (claim: PublicAssertion, direction: "parents" | "children") => {
  if (direction === "parents") {
    if (claim.predicate === "child_of" && claim.subject_id === personId) return claim.object_person_id;
    if (claim.predicate === "parent_of" && claim.object_person_id === personId) return claim.subject_id;
  } else {
    if (claim.predicate === "child_of" && claim.object_person_id === personId) return claim.subject_id;
    if (claim.predicate === "parent_of" && claim.subject_id === personId) return claim.object_person_id;
  }
  return null;
};
const groupRelations = (direction: "parents" | "children"): Relation[] => {
  const grouped = new Map<string, PublicAssertion[]>();
  for (const claim of claims) {
    const id = relationEndpoint(claim, direction);
    if (!id || !personById.has(id)) continue;
    grouped.set(id, [...(grouped.get(id) || []), claim]);
  }
  return [...grouped.entries()].map(([id, edgeClaims]) => ({ other: personById.get(id)!, claims: edgeClaims }));
};
const parents = groupRelations("parents");
const children = groupRelations("children");
const parentIds = new Set(parents.map(({ other }) => other.id));
const siblingClaims = claims.filter((claim) => {
  if (claim.predicate === "child_of" && claim.object_person_id && parentIds.has(claim.object_person_id)) return claim.subject_id !== personId;
  if (claim.predicate === "parent_of" && claim.subject_id && parentIds.has(claim.subject_id)) return claim.object_person_id !== personId;
  return false;
});
const siblingMap = new Map<string, PublicAssertion[]>();
for (const claim of siblingClaims) {
  const id = claim.predicate === "child_of" ? claim.subject_id : claim.object_person_id;
  if (id && personById.has(id)) siblingMap.set(id, [...(siblingMap.get(id) || []), claim]);
}
for (const claim of claims) {
  if (claim.predicate !== "sibling_of") continue;
  const interpretation = (claim.interpretation || "").toLocaleLowerCase("pt-BR");
  if (/(disput|reject|contradict|supersed)/.test(interpretation)) continue;
  const id = claim.subject_id === personId ? claim.object_person_id : claim.object_person_id === personId ? claim.subject_id : null;
  if (!id || id === personId || !personById.has(id)) continue;
  const existing = siblingMap.get(id) || [];
  if (!existing.some((item) => item.id === claim.id)) siblingMap.set(id, [...existing, claim]);
}
const siblings: Relation[] = [...siblingMap.entries()].map(([id, edgeClaims]) => ({ other: personById.get(id)!, claims: edgeClaims }));

const unions = groups.filter((group) => group.kind === "union" && group.participant_ids.includes(personId));
const unionPeople = unions.map((group) => ({
  group,
  people: group.participant_ids.filter((id) => id !== personId).map((id) => personById.get(id)).filter((item): item is PublicPerson => Boolean(item)),
  claims: claims.filter((claim) => claim.subject_kind === "group" && claim.subject_id === group.id),
}));
const ownBiographies = biographies.filter((bio) => bio.person_id === personId);
const nameClaims = personClaims.filter((claim) => ["name", "preferred_name", "alternate_name", "name_spelling_divergence", "name_as_written"].includes(claim.predicate) && claim.literal);
const alternateNames = [...new Set(nameClaims.filter((claim) => claim.id !== person.preferred_name_assertion_id).map((claim) => claim.literal))];
const sourceLinksFor = (assertions: PublicAssertion[]) => [...new Set(assertions.flatMap((claim) => claim.citation_ids || []).map((id) => citationById.get(id)?.source_id).filter((id): id is string => Boolean(id)))];
const personSourceIds = new Set([...sourceLinksFor(personClaims.filter((claim) => claim.subject_id === personId)), ...ownBiographies.flatMap((bio) => bio.source_ids || [])]);
const ownArchive = archiveItems.filter((item) => (item.person_ids || []).includes(personId) || (item.source_ids || []).some((id) => personSourceIds.has(id)));
const dateText = (claim: PublicAssertion) => {
  const date = claim.date;
  if (!date) return "";
  if (date.qualifier === "between" && date.lower_bound?.year && date.upper_bound?.year) return `entre ${date.lower_bound.year} e ${date.upper_bound.year}`;
  if (date.qualifier === "about" && date.components?.year) return `c. ${date.components.year}`;
  if (date.qualifier === "before" && date.components?.year) return `antes de ${date.components.year}`;
  if (date.qualifier === "after" && date.components?.year) return `depois de ${date.components.year}`;
  const months = ["janeiro", "fevereiro", "março", "abril", "maio", "junho", "julho", "agosto", "setembro", "outubro", "novembro", "dezembro"];
  if (date.components?.day && date.components?.month && date.components?.year) return `${date.components.day} de ${months[date.components.month - 1] || date.components.month} de ${date.components.year}`;
  if (date.components?.month && date.components?.year) return `${months[date.components.month - 1] || date.components.month} de ${date.components.year}`;
  return date.components?.year ? String(date.components.year) : date.literal;
};
const predicateLabel: Record<string, string> = { birth: "Nascimento", death: "Falecimento", migration: "Migração", residence: "Residência", marriage: "Casamento", travel_memory_not_confirmed: "Memória de viagem" };
const profileEvents = (snapshot.events || []).filter((event) => (event.subject_kind === "person" && event.subject_id === personId) || unions.some((group) => group.event_ids.includes(event.id)));
const timelineEntries = profileEvents.flatMap((event) => {
  const eventClaims = event.claim_ids.map((id) => claimById.get(id)).filter((claim): claim is PublicAssertion => Boolean(claim));
  const main = eventClaims.find((claim) => Boolean(predicateLabel[claim.predicate]));
  if (!main) return [];
  const placePredicates = main.predicate === "birth" ? ["birth_place"] : main.predicate === "death" ? ["death_place"] : [];
  const place = eventClaims.find((claim) => placePredicates.includes(claim.predicate) && claim.literal)?.literal;
  const union = unionPeople.find(({ group }) => group.event_ids.includes(event.id));
  const context = main.predicate === "marriage" && union ? union.people.map((relative) => relative.label).join(" e ") : "";
  return [{ claim: main, label: predicateLabel[main.predicate], place, context, id: event.id }];
});
const travelEntries = personClaims.filter((claim) => claim.predicate === "travel_memory_not_confirmed").map((claim) => ({ claim, label: predicateLabel[claim.predicate], place: "", context: "", id: claim.id }));
const timeline = [...timelineEntries, ...travelEntries];
const datedTimeline = timeline.filter((entry) => entry.claim.date?.components?.year).sort((a,b) => (a.claim.date?.components?.year || 0) - (b.claim.date?.components?.year || 0) || a.id.localeCompare(b.id));
const undatedTimeline = timeline.filter((entry) => !entry.claim.date?.components?.year);
const isGenericBiographyHeading = (text: string) => {
  const normalized = text.trim().replace(/[.\s]+$/, "").toLocaleLowerCase("pt-BR");
  const match = normalized.match(/^hist[oó]ria de\s+(.+)$/i);
  const suffix = match?.[1] || "";
  const firstName = person.label.trim().split(/\s+/)[0].toLocaleLowerCase("pt-BR");
  const fullName = person.label.toLocaleLowerCase("pt-BR");
  return normalized === fullName || normalized === firstName || suffix === fullName || suffix === firstName;
};
const isBiographyEcho = (text: string) => isGenericBiographyHeading(text);
const isStructuredRepeat = (text: string) => {
  const line = text.trim();
  if (/^(?:Nascimento|Local de nascimento|Falecimento|Local de falecimento)\s*:/i.test(line) && timelineEntries.some(({ claim }) => ["birth", "death"].includes(claim.predicate))) return true;
  if (/^Casou-se com\b/i.test(line) && timelineEntries.some(({ claim }) => claim.predicate === "marriage")) return true;
  if (/^Filiação registrada\s*:/i.test(line) && parents.length > 0) return true;
  if (/^Filhos registrados nos vínculos parentais\s*:/i.test(line) && children.length > 0) return true;
  return false;
};
const biographySourceIds = ownBiographies.flatMap((bio) => bio.source_ids || []);
const archiveSourceIds = ownArchive.flatMap((item) => item.source_ids || []);
const allSourceIds = [...new Set([...sourceLinksFor(personClaims), ...biographySourceIds, ...archiveSourceIds])];
const sourceUrl = (id: string) => sourceHref(id);
---
<SiteLayout active="pessoas" title={person.label} description={`História familiar de ${person.label}: vínculos, relatos e acervo relacionado.`}>
  <div class="editorial-person">
    <nav class="editorial-breadcrumb" aria-label="Caminho de navegação">
      <a href={url("/pt/arvores/")}>Árvores</a><span aria-hidden="true">/</span><a href={url("/pt/pessoas/")}>Pessoas</a><span aria-hidden="true">/</span><span aria-current="page">{person.label}</span>
    </nav>

    <header class="editorial-person-hero">
      <div class="editorial-person-monogram" aria-hidden="true">{initials}</div>
      <div class="editorial-person-heading">
        <p class="editorial-eyebrow">{branchNames.join(" · ") || "Família Zaniratti"}</p>
        <h1>{person.label}</h1>
        {alternateNames.length > 0 && <p class="editorial-aliases"><span>Também registrado como</span> {alternateNames.join(" · ")}</p>}
        <a class="editorial-return" href={returnTree}>← Voltar à árvore neste ponto</a>
      </div>
      <a class="editorial-open-tree" href={returnTree} aria-label={`Ver ${person.label} na árvore`}>Ver na árvore <span aria-hidden="true">→</span></a>
    </header>

    <nav class="editorial-section-nav" aria-label="Nesta ficha"><a href="#historia">História</a><a href="#familia">Família</a><a href="#linha-do-tempo">Linha da vida</a><a href="#acervo-relacionado">Documentos</a><a href="#fontes-historia">Fontes</a></nav>

    <div class="editorial-profile-grid">
      <div class="editorial-profile-main">
        {ownBiographies.length > 0 ? <section id="historia" class="editorial-section editorial-biography" aria-labelledby="biografia">
          <div class="editorial-section-title"><p class="editorial-eyebrow">Memória da família</p><h2 id="biografia">A história de {person.label.split(" ")[0]}</h2></div>
          {ownBiographies.map((bio) => <article class="editorial-biography-block" id={bio.id}>
            {bio.title && !isGenericBiographyHeading(bio.title) && <h3>{bio.title}</h3>}
            <div class="editorial-rich-text">{bio.paragraphs?.filter((paragraph) => !isBiographyEcho(paragraph.text) && !isStructuredRepeat(paragraph.text)).map((paragraph) => <p>{paragraph.text}</p>)}</div>
          </article>)}
        </section> : <section id="historia" class="editorial-section editorial-biography editorial-biography-empty"><p class="editorial-eyebrow">Memória da família</p><h2>A história de {person.label.split(" ")[0]}</h2><p>Os registros reunidos para esta pessoa estão apresentados abaixo, junto à família e aos documentos relacionados.</p></section>}
        {personId === "hist-c43ca697a7a5ddd1" && <p class="editorial-longread-link"><span>Leitura complementar</span><a href={url("/pt/historias/jose-augusto/")}>Ler a biografia atribuída a Edmondo, com a transcrição completa →</a></p>}

        <section class="editorial-section" aria-labelledby="familia">
          <div class="editorial-section-title"><p class="editorial-eyebrow">Laços familiares</p><h2 id="familia">Família</h2></div>
          {parents.length > 0 && <div class="editorial-relation-block"><h3>Pais</h3><div class="editorial-person-links">{parents.map(({ other }) => <article class="editorial-relative"><a class="editorial-relative-name" href={personHref(other.id)}>{other.label}</a></article>)}</div></div>}
          {siblings.length > 0 && <div class="editorial-relation-block"><h3>Irmãos e irmãs <span class="editorial-count">{siblings.length}</span></h3><div class="editorial-person-links">{siblings.map(({ other }) => <article class="editorial-relative"><a class="editorial-relative-name" href={personHref(other.id)}>{other.label}</a></article>)}</div></div>}
          {unionPeople.length > 0 && <div class="editorial-relation-block"><h3>Cônjuges</h3><div class="editorial-person-links">{unionPeople.flatMap(({ people: relatives, claims: unionClaims }) => relatives.map((relative) => <article class="editorial-relative"><a class="editorial-relative-name" href={personHref(relative.id)}>{relative.label}</a><small>Casamento{unionClaims.map((claim) => dateText(claim)).filter(Boolean).map((date) => ` · ${date}`).join("")}</small></article>))}</div></div>}
          {children.length > 0 && <div class="editorial-relation-block"><h3>Filhos e filhas <span class="editorial-count">{children.length}</span></h3><div class="editorial-person-links">{children.map(({ other }) => <article class="editorial-relative"><a class="editorial-relative-name" href={personHref(other.id)}>{other.label}</a></article>)}</div></div>}
          {parents.length === 0 && siblings.length === 0 && children.length === 0 && unionPeople.length === 0 && <p class="editorial-empty">Os vínculos familiares disponíveis aparecem nas fontes e histórias relacionadas.</p>}
          {person.id === "valentim" && <p class="editorial-family-note">O nome da mãe de Valentim não está informado nos registros consultados.</p>}
          {person.id === "reni" && personById.has("lourdes_esposito") && <p class="editorial-family-note">Reni é uma pessoa distinta de <a href={personHref("lourdes_esposito")}>Lourdes Espósito</a>, filha de Grandilia.</p>}
        </section>

        <section class="editorial-section" aria-labelledby="linha-do-tempo">
          <div class="editorial-section-title"><p class="editorial-eyebrow">Vida e percurso</p><h2 id="linha-do-tempo">Linha da vida</h2></div>
          {datedTimeline.length > 0 && <ol class="editorial-timeline">{datedTimeline.map(({ claim, label, place, context }) => <li><span class="editorial-timeline-date">{dateText(claim)}</span><div><strong>{label}</strong>{context && <p>{context}</p>}{place && <p>{place}</p>}{!place && !context && !["birth", "death", "marriage"].includes(claim.predicate) && claim.literal && <p>{claim.literal}</p>}</div></li>)}</ol>}
          {undatedTimeline.length > 0 && <div class="editorial-undated"><h3>Sem data informada</h3><ul>{undatedTimeline.map(({ claim, label, place, context }) => <li><strong>{label}</strong>{context && <span>{context}</span>}{place && <span>{place}</span>}{!place && !context && !["birth", "death", "marriage"].includes(claim.predicate) && claim.literal && <span>{claim.literal}</span>}</li>)}</ul></div>}
          {timeline.length === 0 && <p class="editorial-empty">Não há acontecimentos registrados nesta ficha.</p>}
        </section>

        <section class="editorial-section" aria-labelledby="acervo-relacionado">
          <div class="editorial-section-title"><p class="editorial-eyebrow">Documentos, imagens e registros</p><h2 id="acervo-relacionado">Acervo relacionado</h2></div>
          {ownArchive.length > 0 && <div class="editorial-archive-grid">{ownArchive.map((item) => {
            const imagePath = item.public_path;
            const status = item.status || "catalog_only";
            const itemTitle = item.title;
            return <article class="editorial-archive-card">
              {imagePath && /\.(?:png|jpe?g|webp|gif|avif)$/i.test(imagePath) && <a class="editorial-archive-thumb" href={url("/pt/acervo/" + encodeURIComponent(item.id) + "/")}><img src={url("/" + imagePath.replace(/^\//, ""))} alt={itemTitle} loading="lazy" /></a>}
              <p class="editorial-eyebrow">{({historical_page:"Página do site",historical_image:"Imagem histórica",image:"Imagem",document:"Documento"} as Record<string,string>)[item.kind] || "Acervo"}</p><h3>{itemTitle}</h3>
              {item.description && <p>{item.description}</p>}
              {item.capture_timestamp_utc && <p>{item.capture_timestamp_utc}</p>}
              <p class="editorial-status">{({ public_derivative: "Versão pública", original_public: "Cópia pública", capture_indexed: "Captura indexada", catalog_only: "Referência catalogada", local_copy_review_needed: "Disponibilidade em revisão" } as Record<string,string>)[status] || status}</p>
              <a class="editorial-source-link" href={url("/pt/acervo/" + encodeURIComponent(item.id) + "/")}>{imagePath ? "Abrir imagem e registro" : "Ver item no acervo"} →</a>
            </article>;
          })}</div>}
          {ownArchive.length === 0 && <p class="editorial-empty">Não há uma reprodução pública relacionada a esta ficha neste momento.</p>}
        </section>

        <section class="editorial-section editorial-sources" id="fontes-historia"><details class="editorial-reference-details"><summary>De onde vem esta história</summary>{allSourceIds.length > 0 ? <ul>{allSourceIds.map((id) => <li><a href={sourceUrl(id)}>{sourceById.get(id)?.title || "Referência familiar"}</a></li>)}</ul> : <p>As referências são apresentadas junto aos registros disponíveis no acervo.</p>}</details></section>
      </div>

      <aside class="editorial-profile-aside" aria-label="Resumo da pessoa">
        <div class="editorial-aside-card"><p class="editorial-eyebrow">Na família</p><h2>{person.label}</h2>
          {parents.length > 0 && <div><small>Pais registrados</small><p>{parents.map(({ other }) => <a href={personHref(other.id)}>{other.label}</a>)}</p></div>}
          {unionPeople.length > 0 && <div><small>Uniões</small><p>{unionPeople.flatMap(({ people: relatives }) => relatives.map((relative) => <a href={personHref(relative.id)}>{relative.label}</a>))}</p></div>}
          <div class="editorial-aside-counts"><span><strong>{siblings.length}</strong> irmãos registrados</span><span><strong>{children.length}</strong> filhos registrados</span></div>
          <a class="editorial-aside-tree" href={returnTree}>Encontrar na árvore <span aria-hidden="true">→</span></a>
        </div>
        {ownArchive.length > 0 && <div class="editorial-aside-card editorial-aside-acervo"><p class="editorial-eyebrow">Acervo</p><strong>{ownArchive.length}</strong><span>{ownArchive.length === 1 ? "item relacionado" : "itens relacionados"}</span><a href={url("/pt/acervo/")}>Explorar o acervo →</a></div>}
      </aside>
    </div>
  </div>
</SiteLayout>

<style>
  .editorial-person { --ep-ink: #172b3a; --ep-blue: #326bb0; --ep-pale: #edf3f8; --ep-line: #d8e0e6; --ep-paper: #fffefa; --ep-muted: #5b6873; color: var(--ep-ink); }
  .editorial-breadcrumb { display: flex; flex-wrap: wrap; gap: 9px; margin-bottom: 26px; color: var(--ep-muted); font-size: .85rem; }
  .editorial-breadcrumb a { color: inherit; }
  .editorial-person-hero { display: flex; align-items: center; gap: 22px; padding: clamp(26px,5vw,50px); background: var(--ep-paper); border: 1px solid var(--ep-line); border-radius: 14px; box-shadow: 0 15px 38px rgba(24,44,60,.06); }
  .editorial-person-monogram { display: grid; flex: 0 0 80px; place-items: center; width: 80px; height: 80px; border-radius: 50%; background: var(--ep-pale); color: var(--ep-blue); font-family: Georgia,serif; font-size: 1.5rem; }
  .editorial-person-heading { flex: 1; min-width: 0; }
  .editorial-person h1, .editorial-person h2, .editorial-person h3 { color: var(--ep-ink); }
  .editorial-person h1 { font-size: clamp(2.1rem,5vw,3.7rem); }
  .editorial-eyebrow { margin: 0 0 8px; color: var(--ep-blue); font-size: .72rem; font-weight: 750; letter-spacing: .11em; text-transform: uppercase; }
  .editorial-aliases { margin: 10px 0 5px; color: var(--ep-muted); }
  .editorial-aliases span { font-size: .85rem; }
  .editorial-return { display: inline-block; margin-top: 12px; font-size: .9rem; font-weight: 650; }
  .editorial-open-tree { display: inline-flex; align-items: center; gap: 8px; padding: 12px 16px; border: 1px solid var(--ep-line); border-radius: 8px; color: var(--ep-ink); text-decoration: none; white-space: nowrap; }
  .editorial-open-tree:hover { border-color: var(--ep-blue); color: var(--ep-blue); }
  .editorial-section-nav { display:flex; flex-wrap:wrap; gap:8px; margin:14px 0 0; padding:8px 0; border-bottom:1px solid var(--ep-line); }
  .editorial-section-nav a { padding:7px 11px; border:1px solid var(--ep-line); border-radius:99px; color:var(--ep-ink); background:var(--ep-paper); font-size:.8rem; text-decoration:none; }
  .editorial-section-nav a:hover { border-color:var(--ep-blue); color:var(--ep-blue); }
  .editorial-profile-grid { display: grid; grid-template-columns: minmax(0,1fr) 280px; gap: clamp(28px,5vw,72px); margin-top: 42px; align-items: start; }
  .editorial-section { margin-top: 42px; }
  .editorial-section:first-child { margin-top: 0; }
  .editorial-section-title { margin-bottom: 18px; }
  .editorial-section-title h2 { margin: 0; font-size: clamp(1.7rem,3vw,2.25rem); }
  .editorial-biography { padding: clamp(22px,4vw,36px); border: 1px solid var(--ep-line); border-radius: 12px; color: var(--ep-ink); background: var(--ep-paper); }
  .editorial-biography h2, .editorial-biography h3 { color: var(--ep-ink); }
  .editorial-biography .editorial-eyebrow { color: var(--ep-blue); }
  .editorial-biography .editorial-section-title { margin-bottom: 12px; }
  .editorial-biography-block + .editorial-biography-block { margin-top: 22px; padding-top: 18px; border-top: 1px solid var(--ep-line); }
  .editorial-rich-text { max-width: 72ch; font-size: 1.04rem; line-height: 1.8; }
  .editorial-rich-text p { margin: 0 0 1em; }
  .editorial-rich-text p:last-child { margin-bottom: 0; }
  .editorial-biography a { color: var(--ep-blue); }
  .editorial-biography-empty { background: #f0f4f7; color: var(--ep-ink); }
  .editorial-biography-empty h2 { color: var(--ep-ink); }
