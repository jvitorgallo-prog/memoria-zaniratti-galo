---
import SiteLayout from "../../../layouts/SiteLayout.astro";
import { publicData as snapshot } from "../../../lib/data";
import { url } from "../../../lib/urls";
const archive = snapshot.archive_items || [];
const historicalPages = archive.filter((item) => item.kind === "historical_page");
const diagrams = archive.filter((item) => item.kind === "diagram");
const readable = archive.filter((item) => item.public_path || item.transcript);
const recoveredItems = [...historicalPages, ...diagrams].filter((item) => item.public_path || item.transcript);
const people = snapshot.people || [];
const byId = new Map(people.map((person) => [person.id, person]));
---
<SiteLayout title="Edmondo e o site original" description="A memória do trabalho de Edmondo Zaniratti e o acervo recuperado do site familiar original.">
  <div class="edmondo-page">
    <nav class="edmondo-breadcrumb" aria-label="Caminho de navegação"><a href={url("/pt/")}>Árvore</a><span>/</span><a href={url("/pt/sobre/")}>Sobre</a><span>/</span><span aria-current="page">Edmondo e o site original</span></nav>
    <header class="edmondo-hero"><p class="edmondo-kicker">Memória digital da família</p><h1>Edmondo e o site original</h1><p>Edmondo Zaniratti reuniu genealogias, histórias e imagens da família em um site próprio. Este espaço preserva essa contribuição e permite ler o material que foi recuperado.</p><a href={url("/pt/acervo/")}>Explorar o acervo familiar <span aria-hidden="true">→</span></a></header>
    <div class="edmondo-layout">
      <article class="edmondo-prose">
        <section><p class="edmondo-kicker">Uma memória construída antes deste atlas</p><h2>O trabalho de Edmondo</h2><p>O site original conectava nomes a biografias, árvores, lugares e páginas de família. Suas grafias e narrativas são parte da memória familiar e seguem acessíveis aqui como material histórico, com ligações para as pessoas e documentos relacionados.</p><p>As páginas recuperadas aparecem como reproduções identificadas. A leitura preserva o conteúdo disponível, enquanto o atlas atual organiza as pessoas pelos vínculos que constam no conjunto familiar.</p></section>
        <section class="edmondo-counters" aria-label="Estado do acervo"><div><strong>{historicalPages.length}</strong><span>páginas antigas catalogadas</span></div><div><strong>{diagrams.length}</strong><span>diagramas catalogados</span></div><div><strong>{readable.length}</strong><span>itens com conteúdo para leitura</span></div></section>
        <section><p class="edmondo-kicker">Páginas recuperadas</p><h2>Leia o que chegou até nós</h2>
          {recoveredItems.length ? <div class="edmondo-list">{recoveredItems.map((item) => <article><div><span class="edmondo-type">{item.kind === "diagram" ? "Diagrama" : "Página histórica"}</span><h3>{item.title}</h3><p>{item.description}</p></div><a href={url("/pt/acervo/" + encodeURIComponent(item.id) + "/")}>Ler documento <span aria-hidden="true">↗</span></a></article>)}</div> : <p>As referências do site original permanecem no catálogo enquanto as cópias legíveis são preparadas.</p>}
        </section>
        <section class="edmondo-gap"><p class="edmondo-kicker">Limites do que foi recuperado</p><h2>O catálogo não é uma cópia completa</h2><p>Há páginas, fotografias e capturas listadas em inventários sem um arquivo legível disponível nesta edição. A cobertura total do site antigo é desconhecida; itens sem bytes ou transcrição são identificados como referências catalogadas, sem serem apresentados como conteúdo recuperado.</p><a href={url("/pt/acervo/")}>Ver todos os registros do acervo →</a></section>
      </article>
      <aside class="edmondo-aside"><p class="edmondo-kicker">Pessoas do acervo</p><h2>Seguir pelas histórias</h2><ul>{[...new Set(recoveredItems.flatMap((item) => item.person_ids || []))].map((id) => { const person = byId.get(id); return person && <li><a href={url("/pt/pessoas/" + encodeURIComponent(id) + "/")}>{person.label}</a></li>; })}</ul><a href={url("/pt/acervo-historico/")}>Como ler as capturas históricas →</a></aside>
    </div>
  </div>
</SiteLayout>
<style>
  .edmondo-page{--ed-ink:#172b3a;--ed-blue:#326bb0;--ed-pale:#edf3f8;--ed-line:#d8e0e6;--ed-muted:#5b6873;--ed-paper:#fffefa;color:var(--ed-ink)}.edmondo-breadcrumb{display:flex;flex-wrap:wrap;gap:9px;margin-bottom:24px;color:var(--ed-muted);font-size:.85rem}.edmondo-breadcrumb a{color:inherit}
  .edmondo-hero{padding:clamp(30px,6vw,66px);border-radius:16px;background:#18364b;color:#fff}.edmondo-kicker{margin:0 0 9px;color:var(--ed-blue);font-size:.72rem;font-weight:750;letter-spacing:.12em;text-transform:uppercase}.edmondo-hero .edmondo-kicker{color:#9bc4ee}.edmondo-hero h1{max-width:800px;color:white;font-size:clamp(2.4rem,6vw,4.2rem)}.edmondo-hero>p:not(.edmondo-kicker){max-width:690px;color:#d7e2e9;font-size:1.08rem}.edmondo-hero>a{display:inline-flex;gap:9px;margin-top:10px;padding:12px 15px;border:1px solid rgba(255,255,255,.4);border-radius:7px;color:white;text-decoration:none;font-weight:650}
  .edmondo-layout{display:grid;grid-template-columns:minmax(0,1fr) 260px;gap:32px;margin-top:33px;align-items:start}.edmondo-prose{max-width:820px}.edmondo-prose section{margin-top:38px}.edmondo-prose section:first-child{margin-top:0}.edmondo-prose h2,.edmondo-aside h2{margin:0 0 13px;font-size:clamp(1.55rem,3vw,2rem)}.edmondo-prose>section>p:not(.edmondo-kicker){max-width:72ch;color:var(--ed-muted);line-height:1.8}.edmondo-counters{display:grid;grid-template-columns:repeat(3,1fr);gap:10px}.edmondo-counters div{display:grid;gap:4px;padding:15px;border:1px solid var(--ed-line);border-radius:9px;background:var(--ed-paper)}.edmondo-counters strong{color:var(--ed-blue);font:1.8rem Georgia,serif}.edmondo-counters span{color:var(--ed-muted);font-size:.78rem}.edmondo-list{display:grid;gap:9px}.edmondo-list article{display:flex;justify-content:space-between;gap:16px;align-items:center;padding:16px 18px;border:1px solid var(--ed-line);border-radius:9px;background:var(--ed-paper)}.edmondo-list h3{margin:4px 0;font-size:1.08rem}.edmondo-list p{margin:4px 0 0;color:var(--ed-muted);font-size:.85rem}.edmondo-type{color:var(--ed-blue);font-size:.68rem;font-weight:750;letter-spacing:.1em;text-transform:uppercase}.edmondo-list article>a{flex:0 0 auto;font-weight:650;font-size:.87rem}.edmondo-gap{padding:23px;border-left:3px solid var(--ed-blue);background:var(--ed-pale)}.edmondo-gap a{font-weight:650}.edmondo-aside{position:sticky;top:24px;padding:21px;border:1px solid var(--ed-line);border-radius:11px;background:var(--ed-paper)}.edmondo-aside h2{font-size:1.25rem}.edmondo-aside ul{padding-left:1.1em}.edmondo-aside li+li{margin-top:7px}.edmondo-aside>a{font-size:.85rem}
  @media(max-width:780px){.edmondo-layout{grid-template-columns:1fr}.edmondo-aside{position:static;grid-row:1}.edmondo-counters{grid-template-columns:1fr}.edmondo-list article{align-items:flex-start;flex-direction:column}}
</style>
