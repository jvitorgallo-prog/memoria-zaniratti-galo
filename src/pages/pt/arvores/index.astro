---
import SiteLayout from "../../../layouts/SiteLayout.astro";
import FamilyForest from "../../../components/FamilyForest.astro";
import LocalSearch from "../../../components/LocalSearch.astro";
import { publicData } from "../../../lib/data";
import { url } from "../../../lib/urls";
const data = publicData;
---

<SiteLayout active="arvore" title="Árvores e ramos">
  <div class="forest-home forest-index">
    <p class="breadcrumb"><a href={url("/pt/")}>Memória da família</a> <span aria-hidden="true">/</span> Árvores</p>
    <div class="forest-search-panel">
      <div><p class="atlas-kicker">Encontre em qualquer ramo</p><h2>Buscar pessoas, páginas e fontes</h2></div>
      <LocalSearch people={data.people} branches={data.branches} assertions={data.assertions} sources={data.sources} archiveItems={data.archive_items} />
    </div>
    <aside class="forest-downloads" aria-label="Exportação genealógica">
      <div><p class="atlas-kicker">Leve a pesquisa com você</p><h2>Arquivo genealógico</h2><p>Baixe a exportação GEDCOM ampliada para consultar em programas de genealogia.</p></div>
      <div><a href={url("/downloads/familia-zaniratti.ged")} download>Baixar GEDCOM ampliado</a><a href={url("/downloads/linha-principal.ged")} download>Baixar versão da linha principal</a></div>
    </aside>
    <FamilyForest branches={data.branches} people={data.people} sources={data.sources} assets={data.assets} archiveItems={data.archive_items} />
  </div>
</SiteLayout>
