---
import SiteLayout from "../../layouts/SiteLayout.astro";
import TreeAtlas from "../../components/TreeAtlas.astro";
import { publicData } from "../../lib/data";
const description = "Explore a árvore da família Zaniratti, conheça as pessoas e percorra gerações entre Itália e Brasil.";
---
<SiteLayout active="arvore" title="Árvore" description={description}>
  <TreeAtlas
    people={publicData.people || []}
    branches={publicData.branches || []}
    assertions={publicData.assertions || []}
    groups={publicData.groups || []}
    events={publicData.events || []}
    citations={publicData.citations || []}
    sources={publicData.sources || []}
    focusId="custode"
  />
</SiteLayout>
